# Database
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=mikon

# Auth
JWT_SECRET=<at least 32 random characters>
SESSION_TTL_DAYS=7
BCRYPT_ROUNDS=12

# Rate limits
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_SIGNUP_MAX=5
RATE_LIMIT_AUTH_WINDOW_SEC=900
RATE_LIMIT_API_MAX=240
RATE_LIMIT_API_WINDOW_SEC=60
MAX_BODY_KB=512

# Client
NEXT_PUBLIC_APP_NAME=Mikon
NEXT_PUBLIC_EXERCISE_IMAGE_BASE=https://cdn.jsdelivr.net/gh/yuhonas/free-exercise-db@a859101d633a01c4a1a920d6a8ce41dabba0705f/exercises/
