# Database
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=mikon

# Auth
JWT_SECRET=<at least 32 random characters>
SESSION_TTL_DAYS=7
BCRYPT_ROUNDS=12

# Rate limits
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_SIGNUP_MAX=5
RATE_LIMIT_AUTH_WINDOW_SEC=900
RATE_LIMIT_API_MAX=240
RATE_LIMIT_API_WINDOW_SEC=60
MAX_BODY_KB=512

# Client
NEXT_PUBLIC_APP_NAME=Mikon
NEXT_PUBLIC_EXERCISE_IMAGE_BASE=https://cdn.jsdelivr.net/gh/yuhonas/free-exercise-db@a859101d633a01c4a1a920d6a8ce41dabba0705f/exercises/

# Uploads (uploadthing.com dashboard, API keys)
UPLOADTHING_TOKEN=<your uploadthing token>

# Push notifications (generate with: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=<vapid public key>
VAPID_PRIVATE_KEY=<vapid private key>
VAPID_SUBJECT=mailto:you@example.com

# Email (password reset). Gmail: smtp.gmail.com, port 465, an app password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=<your email address>
SMTP_PASS=<smtp or app password>
MAIL_FROM=Mikon <your email address>

# Public site address used in emailed links
APP_URL=https://your-domain.com
